
<div class="container gap-3 d-flex align-items-center">
    @if(User is not null)
    {
        @if (User.Image.Length == 0)
        {
            <img src="data:@User.ImageFormat;base64,@Convert.ToBase64String(@User.Image)" class="rounded-circle" width="@Size" height="@Size" />
        }
        else
        {
            <div class="profile-initials rounded-circle d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;">
                <span class="text-white">@initials</span>
            </div>
        }
            <span class="">@User.Name</span>
    }
        
    
</div>


@code {


    [Parameter]
    public ApplicationUser? User { get; set; }

    [Parameter]
    public int Size { get; set; }

    //private string username => User?.Name?.Split("")[0] ?? string.Empty;
    private string initials => string.Join("", User.Name.Split(' ').Select(x => x[0])).ToUpper();

    private List<string> hej = new List<string>{ "hej", "hej" };


}
