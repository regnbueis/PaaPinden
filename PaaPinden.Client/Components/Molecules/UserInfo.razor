
<div class="container gap-3 d-flex align-items-center">
    @if(User is not null)
    {
        @if (User.Image.Length > 0)
        {
            <img src="data:@User.ImageFormat;base64,@Convert.ToBase64String(@User.Image)" class="rounded-circle object-fit-cover" width="@Size" height="@Size" />
        }
        else
        {
            <div class="profile-initials rounded-circle d-flex justify-content-center align-items-center" style="width: @(Size)px; height: @(Size)px;">
                <span class="text-white">@initials</span>
            </div>
        }
            <span class="" style="font-size: @(Size/2)px">@User.Name</span>
    }
</div>


@code {
    [Parameter]
    public ApplicationUser? User { get; set; }
    [Parameter]
    public int Size { get; set; }

    private string initials => string.Join("", User.Name.Split(' ').Select(x => x[0])).ToUpper();


}
