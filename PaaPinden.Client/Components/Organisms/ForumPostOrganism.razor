    private string Navigation { get; set; }

    public void CopyToClipboard()
    {
        jsruntime.InvokeVoidAsync("navigator.clipboard.writeText", Navigation);
    }

    protected override async Task OnParametersSetAsync()
    {
        Post = await forumPostRepository.GetByIdAsync(id);
        Navigation = navManager.Uri;
    }
