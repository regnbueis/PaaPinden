@inject IUserRepository userRepository
@inject IForumPostRepository forumPostRepository
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager

@using Microsoft.AspNetCore.Identity

@page "/ForumPosttest"

<h3>@Post.Title</h3>
<div>
    <div>
        <Button Design="Button.ButtonDesign.GreenCurrent">@Topic</Button>
        <UserInfo User="Post.User" Size="30"></UserInfo>
        <Button Design="Button.ButtonDesign.GreenLink">@Post.</Button>
        <Button Design="Button.ButtonDesign.Pink">@PinkButtonText</Button>
        @*TODO: missing three dots dropdown component*@
    </div>
    <div>
        <p>@Post.Description</p>
        <img src="data:@Post.MediaType;base64,@Convert.ToBase64String(Post.Media)" />
    </div>
    <div>
        @if (Post.Link is not null)
        {
            <Button Design="Button.ButtonDesign.GreenLink" Href="@Post.Link">Se opskrift</Button>
        }
    </div>
    <div>
        <div>
            @*like button with number of likes*@
            <Button Design="Button.ButtonDesign.Message">Antal kommentarer vises her på sigt</Button>
            <Button Design="Button.ButtonDesign.Save">Gem</Button>
            <Button Design="Button.ButtonDesign.Notification">Del</Button>
        </div>
    </div>
</div>

@code {

    [Parameter]
    public ForumPost? Post { get; set; }

    [Parameter]
    public string? Topic { get; set; }

    private ApplicationUser? user;

    private bool IsPoster => Post.User == user;
