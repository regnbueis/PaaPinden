@inject IForumPostRepository forumPostRepository
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager navManager
@inject IJSRuntime jsruntime


@rendermode InteractiveServer

@using Microsoft.AspNetCore.Identity

@page "/Forum/{id}"
@*Breadcrumbs sættes ind her*@
@if (Post != null)
{
    <p class="forumpost-header">@Post.Title</p>
    <div>
        <div class="d-flex flex-row flex-grow-1 gap-5 py-3 justify-content-between">
            <div class="d-flex gap-2">
                <Button Design="Button.ButtonDesign.GreenCurrent">@Post.Topic</Button>
                <UserInfo User="@Post.User" Size="30"></UserInfo>
            </div>
            <div class="d-flex gap-2">
                <Button Design="Button.ButtonDesign.Pink">@PinkButtonText</Button>
                <Button Design="Button.ButtonDesign.GreenLink">...</Button>@*TODO: missing three dots dropdown component*@
            </div>
        </div>

        <div class="d-flex flex-row flex-grow-1 gap-5 py-3">
            <p>@Post.Description</p>
            <img src="data:@Post.MediaType;base64,@Convert.ToBase64String(Post.Media)" style="width:33%;" class="rounded-4" />
        </div>

        <div>
            @if (Post.Link is not null)
            {
                <Button Design="Button.ButtonDesign.GreenLink" Href="@Post.Link">Se opskrift</Button>
            }
        </div>
        <div>
            <div class="d-flex flex-row flex-grow-1 column-gap-5 py-3">
                <Button Design="Button.ButtonDesign.Like">@Post.Likes</Button>
                <Button Design="Button.ButtonDesign.Message">7</Button>
                <Button Design="Button.ButtonDesign.Save">Gem</Button>
                <Button Design="Button.ButtonDesign.Save" @onclick="CopyToClipboard">Del</Button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private ApplicationUser? user { get; set; }

    [Parameter]
    public string id { get; set; }

    public ForumPost? Post { get; set; }

    [Parameter]
    public string? Topic { get; set; }

    private bool IsPoster => Post.User == user;
