@page "/test700"
@inject IForumPostRepository repo
@rendermode InteractiveServer

<MudTable T="ForumPost" Items="@posts" Hover="true" Breakpoint="Breakpoint.Sm"
          RowHref="@(post => $"/Forum/{post.Id}")">
    <RowTemplate>
        <MudTd DataLabel="Titel">@context.Title</MudTd>
        <MudTd DataLabel="Forfatter">
            <UserInfo User="@context.User" Size="30"></UserInfo>
        </MudTd>
        <MudTd DataLabel="Emne">@context.Topic</MudTd>
        <MudTd DataLabel="Likes">
            <Button Design="Button.ButtonDesign.Like" Disabled="true">@context.Likes</Button>
            </MudTd>
    </RowTemplate>
</MudTable>
@code {
    private List<ForumPost> posts;

    protected override async Task OnInitializedAsync()
    {
        posts = await repo.GetAllAsync();
    }

}
