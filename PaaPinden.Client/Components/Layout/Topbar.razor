<div class="navbar topbar d-flex justify-content-between align-items-center gap-4 px-3 border-bottom flex-nowrap">
    <NavLink href="" class="navbar-brand d-flex align-items-center gap-2">
        <img src="/logo.png" alt="På pinden" width="65" height="65" class="rounded-circle" />
        <span>På pinden</span>
    </NavLink>

    <div class="d-flex align-items-center gap-2">
        @if (User != null)
        {
            <Button Design="Button.ButtonDesign.Notification" />
            <Button Design="Button.ButtonDesign.Message" />

            <NavLink href=@($"profile/{User.Id}") class= "navbar-brand d-flex align-items-center gap-4" >
                @if (User.Image != null && User.Image.Length > 0)
                {
                    <img src="@($"data:{User.ImageFormat};base64,{Convert.ToBase64String(User.Image)}")" alt="" width="40" height="40" class="object-fit-cover rounded-circle" />
                }
                else
                {
                    <div class="profile-initials rounded-circle d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;">
                        <span class="text-white">@initials</span>
                    </div>
                }
            </NavLink>
        }
        else
        {
            <Button Design="Button.ButtonDesign.GreenLink" Href="Account/Login" Class="topbar-login">Login</Button>
            <Button Design="Button.ButtonDesign.GreenCurrent" Href="Account/Register">Register</Button>
        }
    </div>
</div>

@code {
    [Parameter]
    public ApplicationUser? User { get; set; }

    private string initials
    {
        get
        {
            string[] names = (User?.Name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (names.Length == 0)
                return "?";

            string result = names[0][0].ToString();
            if (names.Length > 1)
                result += names[names.Length - 1][0];

            return result.ToUpperInvariant();
        }
    }
}
