<aside class="border-end">
    <nav class="nav nav-pills flex-column gap-2"
         aria-label="Hovedmenu">
        @if (User is not null)
        {
            <NavLink class="nav-link ColorForSideBarText"
                     href="/" Match="NavLinkMatch.All">
                Hjem
            </NavLink>

            <NavLink class="nav-link ColorForSideBarText" href="/mit-feed">
                Mit feed
            </NavLink>

            <NavLink class="nav-link ColorForSideBarText" href="/forum">
