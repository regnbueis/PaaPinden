            </NavLink>

            <NavLink class="nav-link ColorForSideBarText"
                     href="@($"profile/{User.Id}")">
                Min profil
            </NavLink>
            <NavLink class="nav-link ColorForSideBarText" href="/gemte-opslag">
                Gemte opslag
            </NavLink>

            <NavLink class="nav-link ColorForSideBarText" href="/projekter">
                Projekter
            </NavLink>

            <NavLink class="nav-link ColorForSideBarText" href="/garn-og-pinde">
