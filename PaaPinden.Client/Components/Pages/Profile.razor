@inject IUserRepository userRepository
@page "/profile/{UserId}"

@if (User != null)
{
    <PageTitle>Profil: @User.Name</PageTitle>
 
    <div class="d-flex flex-column gap-2">
        <ProfileHeader User="@User" />

        <div class="d-flex gap-2">
            <Button Design="Button.ButtonDesign.GreenCurrent">Feed posts</Button>
            <Button Design="Button.ButtonDesign.GreenLink">Forum posts</Button>
            <Button Design="Button.ButtonDesign.GreenLink">Projekter</Button>
        </div>
    </div>
}
else
{
    <PageTitle>Profile</PageTitle>
    <p>User not found</p>
}

@code {
    [Parameter]
    public string UserId { get; set; }

    public ApplicationUser? User { get; set; }

    protected override async Task OnInitializedAsync()
    {
        User = await userRepository.GetByIdAsync(UserId);
    }
}
