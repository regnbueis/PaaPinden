@inject IUserRepository userRepository
@inject IFeedPostRepository feedPostRepository
@inject IForumPostRepository forumPostRepository

@page "/profile/{UserId}"
@rendermode InteractiveServer 

@if (isLoading)
{
    <PageTitle>Profil</PageTitle>

    <div class="spinner-border" style="color: #a75f77 !important; width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (User != null)
{
    <PageTitle>Profil: @User.Name</PageTitle>
 
    <div class="d-flex flex-column gap-2">
        <ProfileHeader User="@User" />

        <div class="d-flex gap-3">
            <Button Design='selection == ProfileSelection.Feed ? Button.ButtonDesign.GreenCurrent : Button.ButtonDesign.GreenLink' OnClick='() => Select(ProfileSelection.Feed)'>
                Feed posts
            </Button>

            <Button Design='selection == ProfileSelection.Forum ? Button.ButtonDesign.GreenCurrent : Button.ButtonDesign.GreenLink' OnClick='() => Select(ProfileSelection.Forum)'>
                Forum posts
            </Button>

            @* <Button Design="Button.ButtonDesign.GreenLink" OnClick="() => Select('projects')">Projekter</Button> *@
        </div>

        <div class="row mt-3">
            @if (selection == ProfileSelection.Feed)
            {
                @foreach (FeedPost feedPost in feedPosts)
                {
                    <div class="col">
                        <FeedPostComponent Feedpost="feedPost" />
                    </div>
                }
            }
            else if (selection == ProfileSelection.Forum)
            {
                @foreach (ForumPost forumPost in forumPosts)
                {
                    <div class="col">
                        <ForumPostOrganism Post="forumPost" />
                    </div>
                }
            }
        </div>
    </div>
}
else
{
    <PageTitle>Profile</PageTitle>
    <p>User not found</p>
}

@code {
    [Parameter]
    public string UserId { get; set; }

    public ApplicationUser? User { get; set; }
    private ProfileSelection selection = ProfileSelection.Feed;

    private bool isLoading = true;
    private string? loadedUserId;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        selection = ProfileSelection.Feed;

        User = await userRepository.GetByIdAsync(UserId);

        feedPosts = await feedPostRepository.GetAllByUserIdAsync(UserId);
        forumPosts = await forumPostRepository.GetAllByUserIdAsync(UserId);

        isLoading = false;
    }


    private List<FeedPost> feedPosts = new List<FeedPost>();
    private List<ForumPost> forumPosts = new List<ForumPost>();

    enum ProfileSelection
    {
        Feed,
        Forum,
        Projects
    }


    private async Task Select(ProfileSelection newSelection)
    {
        selection = newSelection;
    }
}
