<svg class="@CssClass"
     viewBox="@ViewBox"
     fill="none"
     stroke="currentColor"
     stroke-width="@StrokeWidth"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false">
    <path d="@PathData" />
</svg>

@code {
    public enum IconDesign
    {
        Like,
        Save,
        Notification,
        Message
    }

    [Parameter]
    public IconDesign Design { get; set; }

    [Parameter]
    public bool IsActive { get; set; }

    private string CssClass
    {
        get
        {
            var cssClass = $"pp-icon pp-icon--{Design.ToString().ToLowerInvariant()}";

            if (IsActive)
                cssClass += " is-active";

            return cssClass;
        }
    }

    private string ViewBox
    {
        get
        {
            if (Design == IconDesign.Like)
                return "1750 2872 82 82";

            return "0 0 32 32";
        }
    }

    private string StrokeWidth
    {
        get
        {
            if (Design == IconDesign.Like)
                return IsActive ? "7" : "4.6";

            return "1.8";
        }
    }

    private string PathData
    {
        get
        {
            switch (Design)
            {
                case IconDesign.Like:
                    return LikePath;
                case IconDesign.Save:
                    return "M9 4 H23 V28 L16 22 L9 28 Z";
                case IconDesign.Notification:
                    return "M7 24 C10 21 10 18 10 14 A6 6 0 0 1 22 14 "
                        + "C22 18 22 21 25 24 Z M16 5 V3 M13 28 C14 30 18 30 19 28";
                case IconDesign.Message:
                    return "M5 6 H27 V23 H15 L8 29 V23 H5 Z";
                default:
                    throw new ArgumentOutOfRangeException(nameof(Design), Design, "Ukendt ikon.");
            }
        }
    }

    private const string LikePath =
        "M1758.19 2946.08 "
        + "C1782.4 2944.35 1810.06 2927.06 1820.44 2908.04 "
        + "1829.08 2890.75 1820.44 2878.65 1808.33 2878.65 "
        + "1799.69 2878.65 1794.5 2885.56 1792.77 2892.48 "
        + "1789.31 2882.1 1782.4 2876.92 1773.75 2878.65 "
        + "1759.92 2880.38 1758.19 2894.21 1765.1 2909.77 "
        + "1773.75 2927.06 1792.77 2937.44 1808.33 2939.17";
}
